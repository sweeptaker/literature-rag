#!/bin/bash
# ===========================================================================
#  ragmini - macOS 步骤 3/6：生成向量（切片 → bge-m3 → embeddings 表）
# ===========================================================================
cd "$(dirname "$0")/.." || exit 1

PY=".venv/bin/python"
[ -x "$PY" ] || PY="python3"

echo "============================================================"
echo " 步骤 3 - 生成向量"
echo "============================================================"
"$PY" run.py embed "$@"
echo
echo "[完成] 下一步：运行 4_提问.command"
read -r -p "按回车退出…" _

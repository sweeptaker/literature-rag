#!/bin/bash
# ===========================================================================
#  ragmini - macOS 步骤 2/6：把 PDF 切片入库
#  用法：双击本文件（默认读 ./pdf 目录）；
#        或把 PDF 文件夹拖到 Terminal 窗口里再回车；
#        或命令行： bash "2_入库PDF.command" /路径/到/PDF目录
#  说明：入库成功后会自动执行一次「期刊指标富集」（JCR 分区 / 影响因子 → 1–6 档）。
# ===========================================================================
cd "$(dirname "$0")/.." || exit 1

PY=".venv/bin/python"
[ -x "$PY" ] || PY="python3"

echo "============================================================"
echo " 步骤 2 - 入库 PDF（PDF → 章节 → 切片 → SQLite）"
echo "============================================================"

if [ "$#" -eq 0 ]; then
  echo "未指定目录，使用默认目录：pdf/"
  "$PY" run.py ingest
else
  "$PY" run.py ingest "$@"
fi

echo
echo "[完成] 下一步：运行 3_生成向量.command"
read -r -p "按回车退出…" _

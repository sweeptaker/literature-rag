#!/bin/bash
# ===========================================================================
#  ragmini - macOS 步骤 5/6：启动网页演示（http://127.0.0.1:8765）
#  服务在本窗口前台运行；按 Ctrl-C 停止。首次启动加载模型需 20~60 秒。
# ===========================================================================
cd "$(dirname "$0")/.." || exit 1

PY=".venv/bin/python"
[ -x "$PY" ] || PY="python3"

PORT="${RAGMINI_PORT:-8765}"
echo "============================================================"
echo " 网页演示：http://127.0.0.1:${PORT}/"
echo " 首次启动需加载模型，请稍候；服务就绪后会自动打开浏览器。"
echo " 停止服务：按 Ctrl-C"
echo "============================================================"

# 后台起服务，轮询就绪后自动打开浏览器
"$PY" run.py serve --port "$PORT" &
SRV=$!
for _ in $(seq 1 90); do
  if curl -s -o /dev/null --max-time 2 "http://127.0.0.1:${PORT}/api/status"; then
    echo "[就绪] 正在打开浏览器…"
    open "http://127.0.0.1:${PORT}/"
    break
  fi
  sleep 1
done
wait "$SRV"

#!/bin/bash
# ===========================================================================
#  ragmini - macOS 附加步骤：期刊指标富集（JCR 分区 / 影响因子 → 1–6 档）
#  注意：「2_入库PDF.command」在入库成功后已自动执行本步骤。
#        只有在你改了 journal_metrics.yaml、或想手动重跑时才需要双击本文件。
#        加 --no-llm 可跳过 AI 兜底（只用人工复核表，离线可用）。
# ===========================================================================
cd "$(dirname "$0")/.." || exit 1

PY=".venv/bin/python"
[ -x "$PY" ] || PY="python3"

echo "============================================================"
echo " 附加步骤 - 期刊指标富集（JCR 分区 / 影响因子 → 1–6 档）"
echo "============================================================"
"$PY" run.py enrich "$@"
echo
echo "[完成] 结果已写入 journals 表（档位 / JIF / JCR 分区）。"
read -r -p "按回车退出…" _
